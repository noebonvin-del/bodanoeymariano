# Postgres connection strings from Neon (see DEPLOY.md)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Cloudinary — from your Cloudinary dashboard (see DEPLOY.md)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Same cloud name + an UNSIGNED upload preset you create in Cloudinary,
# exposed to the browser so guests can upload directly (see DEPLOY.md)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="wedding-guest-uploads"

# Password for the /admin panel — make this a real password, not the placeholder
ADMIN_PASSWORD="change-me"

# Random long random string used to sign the admin login cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET="change-me-too"
